{
  "name": "quizclash",
  "main": "src/worker/index.ts",
  // Must not be newer than the miniflare/workerd build bundled with the
  // installed @cloudflare/vitest-pool-workers: that runtime rejects a
  // compatibility_date it does not know, and every worker test fails to boot.
  // Bump wrangler and the pool together, then raise this date.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  // Cloudflare's free plan requires SQLite-backed Durable Objects
  // (new_sqlite_classes), not the legacy KV-backed new_classes migration.
  // GameRoom only uses ctx.storage.setAlarm/deleteAlarm (no KV get/put),
  // so this is a safe, behavior-preserving change.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
